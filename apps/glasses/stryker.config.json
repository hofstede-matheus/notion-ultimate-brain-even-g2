{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts"
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "timeoutMS": 15000,
  "ignoreStatic": true,
  "incremental": true,
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 70
  },
  "mutate": [
    "src/glasses/content/markdown-to-pages.ts",
    "src/glasses/modules/tasks/calendar/month-grid.ts",
    "src/glasses/modules/_shared/pagination.ts",
    "src/glasses/events/resolve.ts",
    "src/logging/redact.ts",
    "src/cache.ts",
    "src/page-loader.ts",
    "src/web/screens/SettingsForm/dbSelection.ts"
  ]
}
