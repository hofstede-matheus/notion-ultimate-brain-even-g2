{
  "name": "@notion-ub/glasses",
  "version": "2.7.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "qr": "IP=$(ipconfig getifaddr en0 || ipconfig getifaddr en1 || ifconfig | awk '/^[a-z]/ {iface=$1} /inet / && iface ~ /^en/ && $2 !~ /^127/ {print $2; exit}') && [ -n \"$IP\" ] && evenhub qr --http --ip \"$IP\" --port 5173 --path / || echo \"No LAN IP found\"",
    "pack": "pnpm build && evenhub pack app.json dist -o notion-ultimate-brain-even-g2.ehpk",
    "sim": "evenhub-simulator http://localhost:5173",
    "fetch:voice-model": "node scripts/fetch-vosk-model.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.12",
    "@notion-ub/contracts": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "even-toolkit": "^1.7.7",
    "framer-motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.5.0",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "latest",
    "@evenrealities/evenhub-simulator": "0.8.0",
    "@notion-ub/typescript-config": "workspace:*",
    "@tailwindcss/vite": "^4.1.16",
    "@types/react": "^19.2.3",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  }
}
