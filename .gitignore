# Dependencies
node_modules/

# Turborepo
.turbo/

# Build output
dist/
**/dist/
**/dist-lambda/
*.ehpk

# Env / secrets
.env
.env.local
.env.*.local
.env.production
**/.env
**/.env.local
**/.env.*.local
**/.env.production

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS
.DS_Store

# Editor
# .vscode is shared, not personal: settings.json carries the Biome formatter wiring
# and the Copilot conventional-commit instructions, extensions.json the recommendation.
# Everything else in there (launch.json, tasks.json, per-user state) stays ignored.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# Test / coverage
**/coverage/

# Kilo plans (local planning artifacts)
.kilo/plans/

# Offline voice model (~40 MB, fetched via pnpm fetch:voice-model)
**/public/vosk/model.tar.gz

# Terraform
**/.terraform/
**/*.tfvars
!**/terraform.tfvars.example
**/*.tfstate
**/*.tfstate.*
**/dist-lambda.zip
**/crash.log
