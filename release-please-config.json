{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "separate-pull-requests": true,
  "pull-request-title-pattern": "chore(glasses): release ${version}",
  "bootstrap-sha": "fdc7ab6d3fd40655cc33c7f56ce9f95765e33039",
  "packages": {
    "apps/glasses": {
      "release-type": "node",
      "component": "glasses",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "json",
          "path": "app.json",
          "jsonpath": "$.version"
        }
      ]
    }
  }
}
